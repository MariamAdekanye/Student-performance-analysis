library(dplyr)
library(ggplot2)
library(mosaic)
library(readr)
data_mat = read.csv("student-mat.csv", sep = ";")
data_por = read.csv("student-por.csv", sep = ";")
#the merged data represents 382 students that are taking both the Math class
#and the Portuguese class, that is for a given student, that same student is in both classes at that school
data_merged = merge(data_mat, data_por, by = c("school", "sex", "age",
"address", "famsize", "Pstatus","Medu",
"Fedu", "Mjob", "Fjob", "reason",
"nursery", "internet"))
data_merged_clean = data_merged[, c("school", "sex", "age", "address",
"Pstatus", "Mjob", "Fjob", "studytime.x",
"studytime.y", "internet", "absences.x",
"absences.y", "G1.x", "G2.x", "G3.x",
"G1.y", "G2.y", "G3.y")]
names(data_merged_clean) = c("school", "sex", "age", "address", "Pstatus",
"Mjob", "Fjob", "studytime_math", "studytime_por",
"internet", "absences_math", "absences_por",
"G1_math", "G2_math", "G3_math", "G1_por",
"G2_por", "G3_por")
data_merged_clean = as.data.frame(data_merged_clean)
data_merged_clean$G3_diff = data_merged_clean$G3_por - data_merged_clean$G3_math
print(nrow(data_merged_clean))
head(data_merged_clean)
ggplot(data_merged_clean, aes(x = G3_diff)) +
geom_histogram(binwidth = 1, fill = "blue", colour = "orange") +
labs(title = "Distribution of Grade Differences (Portuguese - Math)",
x = "Portuguese G3 - Maths G3 (points out of 20)",
y = "Number of students")
ggplot(data_merged_clean, aes(x = "", y = G3_diff)) +
geom_boxplot(fill = "blue", outlier.colour = "red") +
labs(title = "Boxplot of Grade Differences", y = "Portuguese G3 - Math G3")
